# Example for a dedicated disposable non-Render Linux VM. Verify this unit on the exact host.
[Unit]
Description=Xirel Studio isolated executor companion
After=network.target

[Service]
Type=simple
User=xirel-studio
Group=xirel-studio
WorkingDirectory=/opt/xirel-studio
EnvironmentFile=/etc/xirel-studio/companion.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npm run studio:executor
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
CPUQuota=100%
MemoryMax=1536M
TasksMax=128
LimitNOFILE=512
LimitCORE=0
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure

[Install]
WantedBy=multi-user.target
