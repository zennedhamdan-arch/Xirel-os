# ─────────────────────────────────────────────────────────
# SUPABASE (Database + Auth) — free tier at supabase.com
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for privileged
# operations (e.g. workspace provisioning) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for Drizzle migrations AND the
# app's runtime database client (src/lib/db/index.ts).
#
# PRODUCTION (Vercel): this MUST be the Supabase TRANSACTION POOLER
# string — copy it exactly from
#   Supabase Dashboard → Connect → Transaction Pooler
# (port 6543). Do not hand-write the hostname or credentials. The
# direct connection (port 5432) bypasses PgBouncer and exhausts
# Supabase's connection limit under serverless load (the cause of
# production "CONNECT_TIMEOUT ...pooler.supabase.com:5432" errors).
DATABASE_URL=

# ─────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────
# Base URL of this app, used for OAuth redirect construction.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub OAuth is configured inside the Supabase dashboard
# (Authentication -> Providers -> GitHub), not as separate env
# vars here. Supabase handles the OAuth handshake.

# ─────────────────────────────────────────────────────────
# AI PROVIDERS
# Every key below is OPTIONAL at the infrastructure level.
# The provider abstraction (src/lib/ai) checks at runtime which
# keys are present and marks the rest as "not configured" —
# it never fabricates availability. Add keys as you obtain them.
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter (https://openrouter.ai/keys). NOTE: this was missing from
# this file before — if OPENROUTER_API_KEY is unset in the environment,
# the openrouter provider is simply "not configured" and never tried.
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────
# AI MODEL OVERRIDES (all optional)
# Per-provider default models live in src/lib/ai/models.ts, verified
# against each provider's live model catalog on 2026-09-21. When a
# provider deprecates its default, set the corresponding var here
# (e.g. in Vercel project settings) instead of changing code.
# ─────────────────────────────────────────────────────────
GEMINI_DEFAULT_MODEL=
GROQ_DEFAULT_MODEL=
OPENROUTER_DEFAULT_MODEL=
# Qwen and Moonshot model ids depend on the host/account you use —
# always set them via env rather than assuming a code default:
QWEN_DEFAULT_MODEL=
MOONSHOT_DEFAULT_MODEL=

# ─────────────────────────────────────────────────────────
# BACKGROUND WORKER (Render) — see render.yaml
# ─────────────────────────────────────────────────────────
# The worker needs only DATABASE_URL + the provider keys above.
# All values below are optional tuning with safe defaults.
# WORKER_CONCURRENCY=2
# WORKER_LEASE_SECONDS=300
# WORKER_POLL_MS=2000
# WORKER_HEARTBEAT_MS=15000
# WORKER_SCHEDULER_MS=30000
# WORKER_GRACE_MS=25000
# Comma-separated provider fallback order for worker runs:
# WORKER_PROVIDER_PRIORITY=gemini,openrouter,groq

# ─────────────────────────────────────────────────────────
# PLATFORM CONTROLS
# ─────────────────────────────────────────────────────────
# Comma-separated user ids allowed to toggle the global execution
# pause via /api/system/pause. Unset = nobody (feature disabled).
# GLOBAL_ADMIN_USER_IDS=

# ─────────────────────────────────────────────────────────
# INTEGRATIONS (interfaces only — none are wired yet)
# ─────────────────────────────────────────────────────────
# Nothing below is implemented; keys are documented so operators know
# what will be required. Do NOT set them until the corresponding
# connector ships. See docs/ (Clips Forge boundary, browser service).
# CLIPS_FORGE_API_URL=
# CLIPS_FORGE_API_KEY=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=

# ── Opt-in read-only agent connectors (web and worker, server only) ──
# GitHub: use a fine-grained Contents: read token limited to the single
# repository. Only explicitly listed text files are read and sent to the
# configured AI provider. Do not share credential-bearing files.
# AGENT_GITHUB_WORKSPACE_ID=
# AGENT_GITHUB_REPOSITORY=owner/repo
# AGENT_GITHUB_REF=main
# AGENT_GITHUB_SHARED_FILES=README.md,docs/architecture.md
# AGENT_GITHUB_READ_TOKEN=
# Brave Search: queries are sent to Brave; configure only for a trusted workspace.
# AGENT_WEB_WORKSPACE_ID=
# BRAVE_SEARCH_API_KEY=
# Public page retrieval: exact HTTPS origins, no trailing slash. No
# browser, redirects, private network, cookies, or credentials.
# AGENT_WEB_PAGE_ORIGINS=https://docs.example.com,https://www.example.org

# ── Opt-in durable project worktree (worker only) ──
# Use a private, worker-owned staging copy on a dedicated non-production
# host; never point this at the app checkout, your home, or a secrets mount.
# AGENT_EXEC_WORKSPACE_ID=
# AGENT_EXEC_PROJECT_ID=
# AGENT_EXEC_ROOT=/absolute/path/to/private/staging-worktree
# Leave command execution unset until the staging isolation checks pass.
# AGENT_EXEC_ENABLE=namespaces
# AGENT_EXEC_PRESETS=node-test,test,build
# Required for npm test/build; pin the operator-reviewed package.json bytes.
# AGENT_EXEC_PACKAGE_SHA256=
# Optional trusted preinstalled dependency tree (mounted read-only).
# AGENT_EXEC_MODULES=

# ── Opt-in GitHub publication (worker only; always requires approval) ──
# Uses the configured repository, worktree and shared-file list above.
# Staging repository only; review Actions/deployment triggers before enabling.
# AGENT_GITHUB_BASE_BRANCH=main
# AGENT_GITHUB_WRITE_TOKEN=

# ── Opt-in OpenRouter task roles (unchanged defaults when unset) ──
# OPENROUTER_PLANNER_MODEL=google/gemma-4-26b-a4b-it
# OPENROUTER_TOOL_MODEL=nvidia/nemotron-3.5-lightning
# Set only for a workspace approved to send bounded project memory to OpenRouter.
# If both are set, reranking takes precedence over embeddings for memory ordering.
# OPENROUTER_RETRIEVAL_WORKSPACE_ID=
# OPENROUTER_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
# OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
